# Copy this file to .env.local for local development.
# On Vercel, add each of these under Project Settings -> Environment Variables instead.

# From Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The single shared password staff will use to log into /admin
ADMIN_PASSWORD=choose-a-strong-password

# Any random long string -- used only to sign the admin session cookie.
# Generate one at https://generate-secret.vercel.app/32 or just mash the keyboard.
SESSION_SECRET=replace-with-a-long-random-string

# Your business WhatsApp number, international format, digits only (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
# Your Instagram username
NEXT_PUBLIC_INSTAGRAM_HANDLE=yourusername
